# Neon Postgres — see db/schema.sql and README.md for setup
DATABASE_URL=postgresql://user:password@ep-example-123.region.aws.neon.tech/neondb?sslmode=require

# Google Drive photo storage (OAuth2, uses your own Drive storage) — see README.md
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=optional-folder-id-to-keep-photos-organized
